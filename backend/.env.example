# =========================================================
# VIPLIKE-RADIANT - MYSQL WORKBENCH CONNECTION & SYSTEM CONFIG
# =========================================================

# Backend server port
PORT=3100

# MySQL Workbench connection (viplike_radiant Database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=viplike_radiant

# Gemini AI API Key (smart automatic comment generation)
GEMINI_API_KEY=your_gemini_api_key

# Telegram alert Bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Login security
# JWT signing key (long random string). Leave empty and the backend generates and saves one to backend/data/.jwt_secret
JWT_SECRET=
# First ADMIN account, only used when backend/data/users.json doesn't exist yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
