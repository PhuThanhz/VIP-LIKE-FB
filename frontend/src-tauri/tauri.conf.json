  "identifier": "com.viplike.radiant",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5188",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VIPLIKE RADIANT v2.0 - Professional Facebook Nurturing & Engagement System",
