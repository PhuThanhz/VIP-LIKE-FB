{
  "manifest_version": 3,
  "name": "VIPLIKE Avatar Fast Uploader",
  "version": "1.0.0",
  "description": "Fast, safe bulk Avatar updater for your Facebook Fanpages, right in your real browser.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "https://images.unsplash.com/*",
    "https://randomuser.me/*",
    "http://localhost:3100/*",
    "http://127.0.0.1:3100/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["avatars-data.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
